{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "luckiest-video-studio storyboard",
  "type": "object",
  "required": ["version", "title", "mode", "format", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["launch", "demo", "logos"] },
    "tone": { "type": "string" },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "fps": { "enum": [24, 30, 60] }
      }
    },
    "hyperframes": { "type": "string", "description": "Pinned HyperFrames version for npx, for example 0.8.84" },
    "music": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "description": "Path relative to the run folder" },
        "volume": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0.35 },
        "license": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "duration"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["motion", "logo", "demo"] },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "line": { "type": "string", "description": "What this scene says or shows, one line, used in TIMING.md" },
          "composition": { "type": "string", "description": "motion and logo: sub-composition path relative to composition/, default compositions/<id>.html" },
          "recipe": { "type": "string", "description": "logo: recipe name from references/logo-recipes.md" },
          "source": { "type": "string", "description": "demo: footage path relative to the run folder" },
          "sourceStart": { "type": "number", "minimum": 0, "default": 0 },
          "faceRect": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 4, "maxItems": 4, "description": "demo: speaker's face as [x, y, w, h] fractions of the frame, checked by the face gate" },
          "variables": { "type": "object", "description": "Values the composition reads: copy, colors, logo path" },
          "assets": { "type": "array", "items": { "type": "string" }, "description": "Extra files (relative to the run folder) whose change should trigger a re-render" }
        }
      }
    }
  }
}
